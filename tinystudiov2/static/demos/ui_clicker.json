  "scripts": [
    {
      "id": "script-clicker",
      "name": "JewelClickerLogic",
      "stateData": {},
      "scriptData": [
        {
          "code": "-- Jewel Clicker Game Script\nlocal score = 0\n\nUI.onClick(\"Collect Button\", function()\n    score = score + 1\n    UI.setText(\"Score Label\", \"Crystals Collected: \" .. tostring(score))\n    print(\"Mined crystal! New total:\", score)\nend)\n\n-- Smoothly rotate the jewel\nwhile true do\n    wait(0.016)\n    if Transform then\n        Transform.rotation.y = Transform.rotation.y + 0.02\n        Transform.rotation.x = Transform.rotation.x + 0.01\n    end\nend"
        }
      ]
    }
  ]
