  "models": [],
  "scripts": [
    {
      "id": "script-lander",
      "name": "LanderFlightComputer",
      "stateData": {},
      "scriptData": [
        {
          "code": "-- Lunar Lander Flight Computer\nlocal fuel = 100\nlocal landed = false\nlocal crashed = false\nlocal lastY = (Transform and Transform.position and Transform.position.y) or 16.5\n\nGlobal.fuel = fuel\nGlobal.status = \"IN_FLIGHT\"\n\nwhile true do\n    wait(0.03)\n\n    local dt = Time.dt\n    if not dt or dt <= 0 then dt = 0.03 end\n\n    local currentY = Transform.position.y\n    local vSpeed = (lastY - currentY) / dt\n    lastY = currentY\n\n    local altitude = math.max(0, currentY - 1.0)\n    Global.altitude = altitude\n    Global.vSpeed = vSpeed\n\n    -- Update Telemetry UI\n    UI.setText(\"HUD_Alt\", string.format(\"📏 ALT: %.1f m\", altitude))\n    UI.setText(\"HUD_Speed\", string.format(\"⚡ V-SPD: %.1f m/s\", math.abs(vSpeed)))\n    UI.setText(\"HUD_Fuel\", string.format(\"⛽ FUEL: %d%%\", math.floor(fuel)))\n\n    -- Speed warning coloring\n    if vSpeed > 3.0 then\n        UI.setColor(\"HUD_Speed\", \"#ef4444\")\n    else\n        UI.setColor(\"HUD_Speed\", \"#22c55e\")\n    end\n\n    if not landed and not crashed then\n        -- 1. Main Thruster (W, Space, or Up Arrow)\n        if (Input.isKeyDown(\"Space\") or Input.isKeyDown(\"KeyW\") or Input.isKeyDown(\"ArrowUp\")) and fuel > 0 then\n            fuel = math.max(0, fuel - 0.35)\n            Physics:applyImpulse(0, 0.44, 0)\n        end\n\n        -- 2. Lateral RCS Thrusters (A / D)\n        if (Input.isKeyDown(\"KeyA\") or Input.isKeyDown(\"ArrowLeft\")) and fuel > 0 then\n            fuel = math.max(0, fuel - 0.15)\n            Physics:applyImpulse(-0.16, 0, 0)\n        end\n        if (Input.isKeyDown(\"KeyD\") or Input.isKeyDown(\"ArrowRight\")) and fuel > 0 then\n            fuel = math.max(0, fuel - 0.15)\n            Physics:applyImpulse(0.16, 0, 0)\n        end\n\n        -- Stabilize pitch & roll\n        Transform.rotation.x = 0\n        Transform.rotation.z = 0\n\n        -- 3. Touchdown Check\n        if altitude <= 0.25 then\n            local posX = Transform.position.x\n            local posZ = Transform.position.z\n            local distFromPad = math.sqrt(posX * posX + posZ * posZ)\n\n            if distFromPad <= 4.2 and vSpeed <= 3.2 then\n                landed = true\n                Global.status = \"LANDED\"\n                UI.setText(\"HUD_Status\", \"🎉 TOUCHDOWN! THE EAGLE HAS LANDED!\")\n                UI.setBackgroundColor(\"HUD_Status\", \"rgba(34, 197, 94, 0.95)\")\n                Physics:setVelocity(0, 0, 0)\n            else\n                crashed = true\n                Global.status = \"CRASHED\"\n                if distFromPad > 4.2 then\n                    UI.setText(\"HUD_Status\", \"💥 MISSED THE PAD! CRASHED ON ROCKS!\")\n                else\n                    UI.setText(\"HUD_Status\", \"💥 HARD IMPACT! DESCENT TOO FAST!\")\n                end\n                UI.setBackgroundColor(\"HUD_Status\", \"rgba(239, 68, 68, 0.95)\")\n            end\n        end\n    end\nend\n"
        }
      ]
    }
  ]
